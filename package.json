{
  "name": "sompur",
  "version": "1.0.9",
  "description": "Sompur - um player de música desktop.",
  "license": "MIT",
  "desktopName": "sompur",
  "author": {
    "name": "João Paulo Kowalski",
    "email": "173004112+Jopako@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.Sompur.app",
    "productName": "Sompur",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "deb": {
      "fpm": [
        "--conflicts=meu-app",
        "--replaces=meu-app"
      ]
    },
    "files": [
      "src/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "26.15.3",
    "node-abi": "^4.38.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "music-metadata": "^11.13.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
